{
  "manifest_version": 3,
  "name": "DrawScript 3D — ChatGPT & Claude Canvas Bridge",
  "version": "2.0.0",
  "description": "Turn ChatGPT and Claude answers into animated, narrated 3D drawing lessons. One click to ask, automatic drawing, voice, themes and PNG export.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://inaamshabir.github.io/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DrawScript 3D",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "prompt.js",
        "engine.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://inaamshabir.github.io/*",
        "http://localhost:3000/*",
        "https://*.run.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "popup.html?tab=1",
    "open_in_tab": true
  }
}